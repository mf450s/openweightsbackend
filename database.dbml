Table muscleGroups {
  id integer [pk, increment]
  name varchar [not null]
}

Table muscleRegions {
  id integer [pk, increment]
  name varchar [not null]
  group_id integer [ref: > muscleGroups.id]
}

Table users {
  id integer [pk, increment]
  name varchar [not null]
  default_pause_seconds integer
  email varchar [not null, unique]
  password_hash varchar [not null]
  created_at timestamp [not null]
}

Table user_settings {
  user_id integer [pk, ref: > users.id]
  preferences jsonb [not null, default: '{}']
  updated_at timestamp [not null]
}

Table exercises {
  id integer [pk, increment]
  name varchar [not null]
  muscle_region_id integer [ref: > muscleRegions.id]
  laterality laterality [not null, default: 'bilateral']
  created_by_user_id integer [ref: > users.id, null]
  is_public boolean [not null, default: false]
  execution_notes text
}

Table exercise_alternatives {
  exercise_id integer [ref: > exercises.id]
  alternative_id integer [ref: > exercises.id]

  indexes {
    (exercise_id, alternative_id) [pk]
  }
}

Table training_splits {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  name varchar [not null]
  description text
  created_at timestamp [not null]
}

Table workout_templates {
  id integer [pk, increment]
  split_id integer [ref: > training_splits.id]
  name varchar [not null]
  order_in_split integer
}

Table template_exercises {
  id integer [pk, increment]
  template_id integer [ref: > workout_templates.id]
  exercise_id integer [ref: > exercises.id]
  sets integer
  reps integer
  rir integer
  order_in_template integer
  pause_seconds integer // if null, use user's default
  weight_kg decimal // saved from latest session for auto-filling, can be overridden when performing a session
  updated_at timestamp
}

Table workout_sessions {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  template_id integer [ref: > workout_templates.id, null]   
  performed_at timestamp [not null]
  notes text
  started_at timestamp
  ended_at timestamp
}

Table session_sets {
  id integer [pk, increment]
  session_id integer [ref: > workout_sessions.id]
  exercise_id integer [ref: > exercises.id]
  template_exercise_id integer [ref: > template_exercises.id, null]
  session_notes text
  set_number integer [not null]
  side side [null]
  weight_kg decimal
  reps integer
  rir integer
  completed boolean [default: true]
}

Enum laterality {
  bilateral
  unilateral
}

Enum side {
  left
  right
  bilateral
}