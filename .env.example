APP_NAME=openweightsbackend
APP_ENV=production
API_V1_PREFIX=/api/v1
AUTH_SECRET_KEY=change-me-in-production
AUTH_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# API rate limiting: rolling window per client IP (in-memory, per process)
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS=100
API_RATE_LIMIT_WINDOW_SECONDS=60
# Empty by default: use the direct TCP peer IP and ignore forwarded headers.
API_RATE_LIMIT_TRUSTED_PROXIES=
API_RATE_LIMIT_PROXY_HEADER=X-Forwarded-For

# Docker image/runtime
OW_IMAGE=ghcr.io/mf450s/openweightsbackend
OW_TAG=latest
OW_CONTAINER_NAME=openweightsbackend
OW_RESTART_POLICY=unless-stopped
OW_PORT=8000

# PostgreSQL container
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=openweights-postgres
POSTGRES_DB=openweights
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_VOLUME_NAME=openweights_db_data

# App DB connection for docker-compose
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/openweights
